{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "checklist"
  ],
  "properties": {
    "checklist": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "punto",
          "origen",
          "responsable"
        ],
        "properties": {
          "punto": {
            "type": "string"
          },
          "origen": {
            "type": "string",
            "pattern": "^(analisis|plan)\\."
          },
          "responsable": {
            "enum": [
              "dev",
              "qa",
              "ops"
            ]
          }
        }
      }
    }
  }
}
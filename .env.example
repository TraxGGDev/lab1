# Copia este archivo como .env (nunca lo subas al repositorio: está en .gitignore)
# Proveedor del modelo: gemini | groq | ollama | fake
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Embeddings: gemini | ollama | local | hash (hash = sin red, solo para pruebas)
EMB_PROVIDER=gemini

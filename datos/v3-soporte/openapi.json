    "/v1/transferencias": {
      "post": {
        "operationId": "crearTransferencia",
        "summary": "Crear una transferencia SPEI",
        "x-fuente": "api-04",
        "security": [
          {
            "oauth2": [
              "transferencias:crear"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Misma llave y mismo cuerpo en 24 h devuelve la misma transferencia (200); otro cuerpo devuelve 409 FN-4091"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevaTransferencia"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Aceptada en estado pendiente",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transferencia"
                }
              }
            }
          },
          "200": {
            "description": "Repetición idempotente: misma transferencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transferencia"
                }
              }
            }
          },
          "409": {
            "description": "FN-4091 · Idempotency-Key reutilizada con otro cuerpo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "FN-4001 CLABE inválida · FN-4002 fondos insuficientes · FN-4003 excede límite por operación · FN-4004 límite diario",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "503": {
            "description": "FN-5031 · SPEI no disponible; reintentar con espera exponencial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido o expirado (FN-4011)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Scope insuficiente (FN-4031)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "429": {
            "description": "Límite de tasa excedido (FN-4291)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Segundos a esperar"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },

  "webhooks": {
    "eventoTransferencia": {
      "post": {
        "summary": "Evento de transferencia enviado a la URL del socio",
        "x-fuente": "api-05",
        "parameters": [
          {
            "name": "X-FinNorte-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 del cuerpo con el secreto del webhook"
          }
        ],
        "requestBody": {
          "content": {

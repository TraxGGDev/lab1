{
  "openapi": "3.1.0",
  "info": {
    "title": "API de FinNorte para socios",
    "version": "2026-06",
    "description": "Especificación derivada de la documentación pública del corpus v3-soporte (api-01 a api-10). Datos ficticios para el curso LSCA2318. No incluye información de api-11 (confidencial).",
    "x-fuentes": [
      "api-01",
      "api-02",
      "api-03",
      "api-04",
      "api-05",
      "api-06",
      "api-07",
      "api-08",
      "api-09",
      "api-10"
    ]
  },
  "servers": [
    {
      "url": "https://api.sandbox.finnorte.mx",
      "description": "Sandbox: datos ficticios, sin dinero real (api-01)"
    },
    {
      "url": "https://api.finnorte.mx",
      "description": "Producción: requiere contrato y certificación técnica (api-01)"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "operationId": "obtenerToken",
        "summary": "Obtener token de acceso (client credentials)",
        "x-fuente": "api-02",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret",
                  "scope"
                ],
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string",
                    "description": "Uno o varios separados por espacio",
                    "example": "cuentas:leer transferencias:crear"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "const": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "const": 900,
                      "description": "15 minutos; no hay refresh token"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v2/cuentas/{cuenta_id}": {
      "get": {
        "operationId": "obtenerCuenta",
        "summary": "Datos de la cuenta",
        "x-fuente": "api-03",
        "security": [
          {
            "oauth2": [
              "cuentas:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "cuenta_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "cta_123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cuenta",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cuenta"
                }
              }
            }
          },
          "404": {
            "description": "La cuenta no existe o no está vinculada al socio (no se revela cuál)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido o expirado (FN-4011)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Scope insuficiente (FN-4031)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "429": {
            "description": "Límite de tasa excedido (FN-4291)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Segundos a esperar"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },

  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "cuentas:leer": "Leer cuentas, saldos y movimientos",
              "transferencias:crear": "Crear transferencias",
              "transferencias:leer": "Consultar transferencias",
              "webhooks:administrar": "Administrar webhooks"
            }
          }
        }
      }
    },
    "schemas": {
      "Problema": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "trace_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "FN-4001",
              "FN-4002",
              "FN-4003",
              "FN-4004",
              "FN-4011",
              "FN-4031",
              "FN-4091",
              "FN-4291",
              "FN-5031"
            ]
          },
          "trace_id": {
            "type": "string",
            "description": "Inclúyelo al contactar a soporte"
          }
        },
        "x-fuente": "api-06"
      },
      "Cuenta": {
        "type": "object",
        "properties": {
          "cuenta_id": {
            "type": "string"
          },
          "nivel": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "clabe_ultimos4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          }
        },
        "x-fuente": "api-03"
      },
      "Saldo": {
        "type": "object",
        "properties": {
          "disponible_centavos": {
            "type": "integer"
          },
          "retenido_centavos": {
            "type": "integer"
          },
          "moneda": {
            "const": "MXN"
          }
        },
        "x-fuente": "api-03"
      },
      "Movimiento": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "monto_centavos": {
            "type": "integer"
          },
          "concepto": {
            "type": "string"
          }
        },
        "x-nota": "Campos de ejemplo: el corpus no detalla la estructura del movimiento"
      },
      "NuevaTransferencia": {
        "type": "object",
        "required": [
          "cuenta_origen",
          "clabe_destino",
          "monto_centavos",
          "concepto",
          "referencia_numerica"
        ],
        "additionalProperties": false,
        "properties": {
          "cuenta_origen": {
            "type": "string"
          },
          "clabe_destino": {
            "type": "string",
            "pattern": "^\\d{18}$"
          },
          "monto_centavos": {
            "type": "integer",
            "minimum": 1
          },
          "concepto": {
            "type": "string",
            "maxLength": 40
          },
          "referencia_numerica": {
            "type": "string",
            "pattern": "^\\d{7}$"
          }
        },
        "x-fuente": "api-04"
      },
      "Transferencia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "pendiente",
              "liquidada",
              "rechazada",
              "devuelta"
            ]
          },
          "monto_centavos": {
            "type": "integer"
          },
